rectangle "Staging / Pre-prod" <<Staging>> as Staging {
  skinparam RectangleBorderColor<<Staging>> #2b85e7
  skinparam RectangleFontColor<<Staging>> #2b85e7
  skinparam RectangleBorderStyle<<Staging>> dashed

  rectangle "VM: stateful (staging)" <<StagingStaging_vm>> as StagingStaging_vm {
    skinparam RectangleBorderColor<<StagingStaging_vm>> #23a2d9
    skinparam RectangleFontColor<<StagingStaging_vm>> #23a2d9
    skinparam RectangleBorderStyle<<StagingStaging_vm>> dashed

    rectangle "VM: LB (staging)" <<StagingStaging_vmVm_staging_lb>> as StagingStaging_vmVm_staging_lb {
      skinparam RectangleBorderColor<<StagingStaging_vmVm_staging_lb>> #64748b
      skinparam RectangleFontColor<<StagingStaging_vmVm_staging_lb>> #64748b
      skinparam RectangleBorderStyle<<StagingStaging_vmVm_staging_lb>> dashed

      rectangle "load-balancer\n<size:10>[[Nginx]]</size>\n\nЕдиная точка входа: распределение трафика, TLS termination" <<StagingStaging_vmVm_staging_lbLoadBalancer>> as StagingStaging_vmVm_staging_lbLoadBalancer
    }
    rectangle "VM: Keycloak (staging)" <<StagingStaging_vmVm_staging_iam>> as StagingStaging_vmVm_staging_iam {
      skinparam RectangleBorderColor<<StagingStaging_vmVm_staging_iam>> #64748b
      skinparam RectangleFontColor<<StagingStaging_vmVm_staging_iam>> #64748b
      skinparam RectangleBorderStyle<<StagingStaging_vmVm_staging_iam>> dashed

      rectangle "iam\n<size:10>[[Keycloak]]</size>\n\nIdentity and Access Management (Keycloak)" <<StagingStaging_vmVm_staging_iamIam>> as StagingStaging_vmVm_staging_iamIam
    }
    rectangle "VM: БД, кэш, Kafka (staging)" <<StagingStaging_vmVm_staging_data>> as StagingStaging_vmVm_staging_data {
      skinparam RectangleBorderColor<<StagingStaging_vmVm_staging_data>> #64748b
      skinparam RectangleFontColor<<StagingStaging_vmVm_staging_data>> #64748b
      skinparam RectangleBorderStyle<<StagingStaging_vmVm_staging_data>> dashed

      database "PostgreSQL (master)\n<size:10>[[PostgreSQL]]</size>\n\nЕдиная точка записи: users_db, requests_db, payments_db, notifications_db, audit_db. Синхронная репликация на read replicas; RPO=0." <<StagingStaging_vmVm_staging_dataPostgresMaster>> as StagingStaging_vmVm_staging_dataPostgresMaster
      database "PostgreSQL (read replicas)\n<size:10>[[PostgreSQL]]</size>\n\nЧтение только с реплик (streaming replication). Масштабирование чтения; ~28K RPS при cache hit 80% (2.07)." <<StagingStaging_vmVm_staging_dataPostgresReplicas>> as StagingStaging_vmVm_staging_dataPostgresReplicas
      rectangle "Кэш\n<size:10>[[Redis Cluster]]</size>\n\nРаспределённый кэш Cache-Aside (профили, сессии, результаты запросов, rate limit)" <<StagingStaging_vmVm_staging_dataCache>> as StagingStaging_vmVm_staging_dataCache
      queue "Event Bus\n<size:10>[[Apache Kafka]]</size>\n\nАсинхронные события между сервисами (в т.ч. audit.events, security.events для аудита — 3.02)" <<StagingStaging_vmVm_staging_dataEventBus>> as StagingStaging_vmVm_staging_dataEventBus
      queue "Шина логов\n<size:10>[[Apache Kafka]]</size>\n\nБуфер и поток логов, сглаживание пиков" <<StagingStaging_vmVm_staging_dataLogBus>> as StagingStaging_vmVm_staging_dataLogBus
    }
    rectangle "VM: Vault (staging)" <<StagingStaging_vmVm_staging_vault>> as StagingStaging_vmVm_staging_vault {
      skinparam RectangleBorderColor<<StagingStaging_vmVm_staging_vault>> #64748b
      skinparam RectangleFontColor<<StagingStaging_vmVm_staging_vault>> #64748b
      skinparam RectangleBorderStyle<<StagingStaging_vmVm_staging_vault>> dashed

      rectangle "Vault (секреты)\n<size:10>[[HashiCorp Vault]]</size>\n\nУправление секретами: БД, Redis, Kafka, IAM client_secret, платёжные API-ключи (3.04)" <<StagingStaging_vmVm_staging_vaultSecretsVault>> as StagingStaging_vmVm_staging_vaultSecretsVault
    }
  }
  rectangle "Kubernetes (staging)" <<StagingStaging_k8s>> as StagingStaging_k8s {
    skinparam RectangleBorderColor<<StagingStaging_k8s>> #23a2d9
    skinparam RectangleFontColor<<StagingStaging_k8s>> #23a2d9
    skinparam RectangleBorderStyle<<StagingStaging_k8s>> dashed

    rectangle "ns: apps (staging)" <<StagingStaging_k8sK8s_stagingNs_staging_apps>> as StagingStaging_k8sK8s_stagingNs_staging_apps {
      skinparam RectangleBorderColor<<StagingStaging_k8sK8s_stagingNs_staging_apps>> #0284c7
      skinparam RectangleFontColor<<StagingStaging_k8sK8s_stagingNs_staging_apps>> #0284c7
      skinparam RectangleBorderStyle<<StagingStaging_k8sK8s_stagingNs_staging_apps>> dashed

      rectangle "Сбор логов\n<size:10>[[Fluent Bit]]</size>\n\nАгенты на узлах: сбор и пересылка логов с сервисов" <<StagingStaging_k8sK8s_stagingNs_staging_appsLogCollector>> as StagingStaging_k8sK8s_stagingNs_staging_appsLogCollector
      rectangle "Сбор метрик\n<size:10>[[Prometheus]]</size>\n\nPull-скрейпинг Prometheus с сервисов и экспортёров (RED/USE, NFR-009)" <<StagingStaging_k8sK8s_stagingNs_staging_appsMetricsCollector>> as StagingStaging_k8sK8s_stagingNs_staging_appsMetricsCollector
      rectangle "front\n<size:10>[[React]]</size>\n\nВеб-интерфейс для взаимодействия с системой" <<StagingStaging_k8sK8s_stagingNs_staging_appsFront>> as StagingStaging_k8sK8s_stagingNs_staging_appsFront
      rectangle "Audit Service\n<size:10>[[Spring Boot]]</size>\n\nАудит операций и безопасности: audit_logs, security_events (3.02)" <<StagingStaging_k8sK8s_stagingNs_staging_appsAuditService>> as StagingStaging_k8sK8s_stagingNs_staging_appsAuditService
      rectangle "api-gateway\n<size:10>[[Spring Cloud Gateway]]</size>\n\nМаршрутизация API, аутентификация (JWT), авторизация (RBAC), rate limiting, публикация событий 401/403 и логина (3.02)" <<StagingStaging_k8sK8s_stagingNs_staging_appsApiGateway>> as StagingStaging_k8sK8s_stagingNs_staging_appsApiGateway
      rectangle "User Service\n<size:10>[[Spring Boot]]</size>\n\nПрофили, сессии, роли (RBAC), публикация событий назначения/снятия ролей в аудит (3.01, 3.02)" <<StagingStaging_k8sK8s_stagingNs_staging_appsUserService>> as StagingStaging_k8sK8s_stagingNs_staging_appsUserService
      rectangle "Request Processing Service\n<size:10>[[Spring Boot]]</size>\n\nОбработка запросов (PROCESS_DATA, REPORT, EXPORT, RESOURCES)" <<StagingStaging_k8sK8s_stagingNs_staging_appsRequestProcessingService>> as StagingStaging_k8sK8s_stagingNs_staging_appsRequestProcessingService
      rectangle "Payment Service\n<size:10>[[Spring Boot]]</size>\n\nПлатежи, интеграция с провайдером, Outbox" <<StagingStaging_k8sK8s_stagingNs_staging_appsPaymentService>> as StagingStaging_k8sK8s_stagingNs_staging_appsPaymentService
      rectangle "Notification Service\n<size:10>[[Spring Boot]]</size>\n\nУведомления (Email, SMS, Push), потребитель событий" <<StagingStaging_k8sK8s_stagingNs_staging_appsNotificationService>> as StagingStaging_k8sK8s_stagingNs_staging_appsNotificationService
      rectangle "OpenTelemetry Collector\n<size:10>[[OpenTelemetry Collector]]</size>\n\nПриём OTLP (метрики, трейсы) от приложений; экспорт в хранилище метрик и в Jaeger/Zipkin" <<StagingStaging_k8sK8s_stagingNs_staging_appsOtelCollector>> as StagingStaging_k8sK8s_stagingNs_staging_appsOtelCollector
    }
  }
}

