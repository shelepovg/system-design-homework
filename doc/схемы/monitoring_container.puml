  BorderColor #1e73ce
}
skinparam rectangle<<SystemStorage>>{
  BackgroundColor #2b85e7
  FontColor #f1ffff
  BorderColor #1e73ce
}
skinparam queue<<SystemEventBus>>{
  BackgroundColor #23a2d9
  FontColor #ffffff
  BorderColor #1892c5
}
skinparam rectangle<<SystemSecretsVault>>{
  BackgroundColor #23a2d9
  FontColor #ffffff
  BorderColor #1892c5
}
