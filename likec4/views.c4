views {
    view context of system {
        title 'System/Контекстная диаграмма'
        description 'Диаграмма контекста системы'

        include users,
                system,
                system.*,
                system_ext
                }

    view user_container of users {
        title 'users/Контейнерная диаграмма'
        description 'Подробно описывает набор пользователей'

        include users,
                users.*,
                system
    }

    view external_system_container of system_ext {
        title 'system_ext/Контейнерная диаграмма'
        description 'Подробная диаграмма внешних систем'

        include system_ext,
                system_ext.*,
                system
    }

    view monitoring_container of system.monitoring {
        title 'System/Система мониторинга/Контейрная диаграмма'
        description 'Логи: сбор → Kafka → обработка → хранение → Grafana. Метрики: Prometheus scrape → TSDB → Grafana/алерты. OTLP: OpenTelemetry Collector → Jaeger/Zipkin и remote write метрик. APM: New Relic/Datadog (NFR-009, 2.09). Алертинг → внешние каналы (PagerDuty, Slack, Email).'

        include system,
                monitoring,
                monitoring.*,
                system.*,
                // system_ext.ops_alert_channels
    }
    view backend_container of system.backend {
        title 'System/Обработка пользовательских запросов/Контейнерная диаграмма'
        description 'Микросервисы, взаимодействие с БД, кэшем, Event Bus и внешними системами'

        include system,
                backend,
                backend.*,
                *
    }

    view db_container of system.storage {
        title 'System/Хранение данных/Контейрная диаграмма'
        description 'PostgreSQL: запись в master, чтение с read replicas (2.13). Кэш Redis (Cache-Aside). Репликация бэкапов в отдельное хранилище (WAL, полный снимок, PITR).'

        include *,
                system

    }

    view access_control_rbac of system {
        title 'System/Безопасность/Схема архитектуры управления доступами с RBAC'
        description 'Аутентификация (JWT, IAM), авторизация RBAC. Аудит: 401/403, логин, смена ролей → Event Bus → Audit Service. Секреты: Vault. Документы 3.01, 3.02, 3.04.'

        include users,
                users.*,
                system,
                system.load-balancer,
                system.front,
                system.api-gateway,
                system.iam,
                system.backend.user-service,
                system.backend.audit-service,
                system.storage.cache,
                system.storage.postgres-master,
                system.event-bus,
                system.secrets-vault,
                system_ext,
                system_ext.iam_ext
                
    }

    deployment view deployment_production {
        title 'System/Развёртывание/Production'
        description 'Edge: WAF/CDN. Регион A: VM (LB, IAM, PG, Redis, Kafka, Vault, MinIO, o11y storage) + K8s (ingress, gateway, backend, observability). Регион B: DR (PG replicas, Kafka, Redis, сокращённый K8s). Регион C: две гео-копии backup-storage (NFR-006, NFR-007, 4.01).'

        include production.**,
                production
    }

    deployment view deployment_staging {
        title 'System/Развёртывание/Staging'
        description 'VM: stateful + LB + IAM; Kubernetes: объединённый ns приложений и лёгкий o11y.'

        include staging.**,
                staging
    }

    deployment view deployment_all {
        title 'System/Развёртывание/Все среды'
        description 'Production: multi-region (edge + primary + DR + гео-бэкапы) и Staging (упрощённый контур).'

        include production.**,
                staging.**,
                production,
                staging
    }
    deployment view deployment{
        title 'System/Развёртывание/Верхнеуровневая диаграмма'
        description 'Для презентации'

        include production,
                staging,
                production.*,
                staging.*,
    } 
}